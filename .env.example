# ------- 数据库 -------
POSTGRES_USER=unify
POSTGRES_PASSWORD=unify
POSTGRES_DB=unify
# 容器内由 compose 覆写为 db:5432；本机直跑后端时改成 127.0.0.1:5432
DATABASE_URL=postgresql+asyncpg://unify:unify@127.0.0.1:5432/unify
REDIS_URL=redis://127.0.0.1:6379/0

# ------- 平台 1：飞书（必填，主平台） -------
# 开放平台 https://open.feishu.cn/app → 创建企业自建应用
# 权限：im:message、im:message:send_as_bot、im:resource（发文件用）
# 事件订阅方式选「长连接」，订阅 im.message.receive_v1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 若使用飞书国际版 Lark，把域名换成 open.larksuite.com（默认国内）
FEISHU_BASE_URL=https://open.feishu.cn

# ------- 平台 2：钉钉（必填） -------
# 开放平台 https://open-dev.dingtalk.com → 创建应用 → 机器人 → 消息接收模式选 Stream
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=

# ------- 平台 3：Telegram（选填，凑第三个平台可拿 +3） -------
# 找 @BotFather 发 /newbot 拿 token
TELEGRAM_BOT_TOKEN=

# ------- 平台 4：邮箱（IMAP 收 + SMTP 发，标准协议、不需要审核） -------
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成授权码（填到 EMAIL_PASSWORD）
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启 → 客户端授权密码
# 服务器地址：QQ → imap.qq.com / smtp.qq.com；163 → imap.163.com / smtp.163.com
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_POLL_SECONDS=30
EMAIL_MARK_SEEN=true

# ------- AI（选填；不填则自动降级为规则摘要/模板草稿） -------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ------- 运行参数 -------
OUTBOX_WORKERS=2
OUTBOX_MAX_ATTEMPTS=5
SLA_MINUTES=15
LOG_LEVEL=INFO
# ---- 访问控制 ----
# 这个网页里装的是你所有平台的消息原文，监听 0.0.0.0 或开隧道后就是公开的。
# 填了口令，打开网页必须先输口令；留空 = 不校验（只适合纯本机自己看）。
ACCESS_PASSWORD=
ACCESS_COOKIE_DAYS=7